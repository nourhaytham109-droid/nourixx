{
  "name": "mathaq-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic restaurant POS with PostgreSQL persistence",
  "main": "main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "admin:create": "node scripts/create-admin.js",
    "build:win": "electron-builder --win nsis --x64",
    "build:win:dir": "electron-builder --dir --win --x64",
    "package:win:install-kit": "node scripts/package-win-install-kit.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdf-to-printer": "^5.8.1"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nourix.pos",
    "productName": "Nourix POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "server.js",
      "app.js",
      "index.html",
      "styles.css",
      "schema.sql",
      "assets/**/*",
      "lib/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/dist/**",
      "node_modules/pdf-to-printer/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nourix POS"
    },
    "artifactName": "Nourix-Setup-${version}-${arch}.${ext}"
  }
}
